# Kavach Environment Configuration (Sample)
# Copy to .env and adjust as needed for your local hardware

# Model Selection: llama3:8b | qwen2.5:3b | phi3:mini
KAVACH_LLM_MODEL=qwen2.5:3b
KAVACH_EMBED_MODEL=nomic-embed-text
KAVACH_OLLAMA_BASE_URL=http://localhost:11434

# Chunking & Retrieval Parameters
KAVACH_CHUNK_SIZE=800
KAVACH_CHUNK_OVERLAP=120
KAVACH_TOP_K=4
KAVACH_MAX_ANSWER_CHARS=1500

# Security & Sovereignty
KAVACH_ALLOW_NETWORK=false
KAVACH_FAIL_CLOSED=true
